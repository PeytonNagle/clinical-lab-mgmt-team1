<mxfile>
  <diagram id="arch" name="Architecture">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1160" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Clinical Lab Management System: architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="6" width="840" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;Staff users (web browser)&lt;/b&gt;&lt;br&gt;Lab manager · Cashier · Specimen collector · Technician · Pathologist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="840" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="pres" value="&lt;b&gt;Presentation layer&lt;/b&gt;&lt;br&gt;Django templates + Bootstrap 5: patient, order, sample collection and label, supply check, result upload, patient history, inventory and lab info pages. Lab info reaches every page footer through a context processor. Django admin at /admin/ for is_staff users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="840" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="req" value="Request handling layer" style="swimlane;startSize=26;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="840" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;URL routing&lt;/b&gt;&lt;br&gt;config/urls.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="req">
          <mxGeometry x="225" y="40" width="180" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;Sessions, CSRF, login required, forced password change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="req">
          <mxGeometry x="15" y="40" width="180" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;role_required&lt;/b&gt;&lt;br&gt;Role check on most views (403 if not allowed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="req">
          <mxGeometry x="435" y="40" width="180" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;Views + forms&lt;/b&gt;&lt;br&gt;Function and class-based views, Django forms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="req">
          <mxGeometry x="645" y="40" width="180" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="req" source="r2" target="r1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="req" source="r1" target="r3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="er3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="req" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Application layer: Django apps" style="swimlane;startSize=26;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="374" width="840" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;core&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• Users and roles&lt;br&gt;• Login, password set/change&lt;br&gt;• Staff registration&lt;br&gt;• Activity log (log_event)&lt;br&gt;• Lab info: name, address, phone, hours&lt;br&gt;• Seed and setup commands&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="app">
          <mxGeometry x="12" y="38" width="195" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="lab" value="&lt;b&gt;lab&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• Patients (soft delete)&lt;br&gt;• Test orders + insurance&lt;br&gt;• Result import:&lt;br&gt;&amp;nbsp;&amp;nbsp;parse → match → save&lt;br&gt;• Panel results: BMP, CBC, lipid&lt;br&gt;• Patient history + activity log&lt;br&gt;• Samples: collect, Code 128 label&lt;br&gt;&amp;nbsp;&amp;nbsp;(print once, manager reprint)&lt;br&gt;• Supply check before a test runs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="app">
          <mxGeometry x="219" y="38" width="195" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="billing" value="&lt;b&gt;billing&lt;/b&gt;&lt;br&gt;MVP 2 (not built yet)&lt;br&gt;Purchases, receipts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=12;" vertex="1" parent="app">
          <mxGeometry x="633" y="38" width="195" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inventory" value="&lt;b&gt;inventory&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• Supply items (soft delete)&lt;br&gt;• Stock lots: receive, correct,&lt;br&gt;&amp;nbsp;&amp;nbsp;expiry dates&lt;br&gt;• Supplies each test uses&lt;br&gt;• stock.py: check stock, take&lt;br&gt;&amp;nbsp;&amp;nbsp;soonest-expiring lot first&lt;br&gt;• Lab's supply check reads stock;&lt;br&gt;&amp;nbsp;&amp;nbsp;result import takes it out&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="app">
          <mxGeometry x="426" y="38" width="195" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="ea1" value="" style="html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="app" source="lab" target="inventory">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="orm" value="&lt;b&gt;Data access layer&lt;/b&gt;&lt;br&gt;Django ORM: models and migrations (PanelResult abstract base for the three result models)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="658" width="840" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;SQLite (local)&lt;br&gt;PostgreSQL via DATABASE_URL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="748" width="220" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="users" target="pres">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pres" target="req">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="req" target="app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="app" target="orm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="orm" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;Analyzer result files&lt;/b&gt;&lt;br&gt;.txt, HL7-style&lt;br&gt;Chemistry: BMP, lipid&lt;br&gt;Hematology: CBC&lt;br&gt;&lt;i&gt;Uploaded by a technician&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="34" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="files" target="users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="patterns" value="&lt;b&gt;Patterns&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• Layered architecture&lt;br&gt;• Model-View-Template (Django MVC)&lt;br&gt;• Role-based access control&lt;br&gt;• Soft delete for patients and supply items&lt;br&gt;• Abstract base model for panel results&lt;br&gt;• Audit trail (activity log)&lt;br&gt;• Single-row settings model (LabInfo)&lt;br&gt;• Stock used soonest-expiry first&lt;br&gt;• Import pipeline: parse → validate → match → save&lt;br&gt;• Management commands for seed data&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="230" width="260" height="230" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
